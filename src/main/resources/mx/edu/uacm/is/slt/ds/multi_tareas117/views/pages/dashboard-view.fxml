<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.RowConstraints?> <?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.edu.uacm.is.slt.ds.multi_tareas117.controller.DashboardController">
    <padding>
        <Insets top="20" left="20" right="20" bottom="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Tablero Kanban" styleClass="h1" HBox.hgrow="ALWAYS"/>
        <Button fx:id="createTaskButton" text="Crear Tarea" styleClass="button-success"
                onAction="#onCreateTaskClick">
            <graphic>
                <FontIcon iconLiteral="fas-plus"/>
            </graphic>
        </Button>
    </HBox>

    <GridPane fx:id="kanbanGrid" VBox.vgrow="ALWAYS" hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="120" maxWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25" fx:id="colTodo"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25" fx:id="colWeek"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25" fx:id="colDoing"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25" fx:id="colDone"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="NEVER" minHeight="50"/>
            <RowConstraints vgrow="ALWAYS" fx:id="rowRrhh"/>
            <RowConstraints vgrow="ALWAYS" fx:id="rowVentas"/>
            <RowConstraints vgrow="ALWAYS" fx:id="rowMktg"/>
            <RowConstraints vgrow="ALWAYS" fx:id="rowAtc"/>
        </rowConstraints>

        <Label text="Por hacer" GridPane.columnIndex="1" GridPane.rowIndex="0"
               styleClass="kanban-header, bg-warning"/>
        <Label text="Esta semana" GridPane.columnIndex="2" GridPane.rowIndex="0"
               styleClass="kanban-header, bg-primary"/>
        <Label text="Haciendo" GridPane.columnIndex="3" GridPane.rowIndex="0"
               styleClass="kanban-header, bg-danger"/>
        <Label text="Hecho" GridPane.columnIndex="4" GridPane.rowIndex="0"
               styleClass="kanban-header, bg-success"/>

        <Label text="Recursos Humanos" GridPane.columnIndex="0" GridPane.rowIndex="1"
               styleClass="kanban-category-label"/>
        <Label text="Ventas" GridPane.columnIndex="0" GridPane.rowIndex="2"
               styleClass="kanban-category-label"/>
        <Label text="Marketing" GridPane.columnIndex="0" GridPane.rowIndex="3"
               styleClass="kanban-category-label"/>
        <Label text="Atención al cliente" GridPane.columnIndex="0" GridPane.rowIndex="4"
               styleClass="kanban-category-label"/>

    </GridPane>
</VBox>